# Plantilla sin secretos. Copia a .env y completa los valores locales.

# Frontend
VITE_API_URL=http://localhost:4000

# SQL Server: login exclusivo de la API
DB_SERVER=127.0.0.1
DB_INSTANCE_NAME=
DB_PORT=51433
DB_NAME=Instalaciones Raquel
DB_USE_WINDOWS_AUTH=false
DB_USER=raquel_erp_app
DB_PASSWORD=
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Sesiones y activación inicial de la cuenta superadministradora
# Generar JWT_SECRET localmente. No utilizar un valor de ejemplo.
JWT_SECRET=
# Secreto independiente para firmar los códigos de recuperación; mínimo 32 caracteres aleatorios.
PASSWORD_RESET_SECRET=
# Bootstrap de un solo uso: retirar ambas variables una vez activada la cuenta.
BOOTSTRAP_USER_EMAIL=
BOOTSTRAP_USER_PASSWORD=

# Correo SMTP para recuperación de contraseña (465 SSL o 587 STARTTLS).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# API local
CORS_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
PORT=4000

# Integración opcional
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
